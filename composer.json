{
    "name": "repman-io/repman",
    "type": "project",
    "description": "PHP Repository Manager - private package manager and fast packagist proxy",
    "keywords": [
        "php",
        "composer",
        "repository-management",
        "packagist-mirror",
        "packages",
        "private-packagist",
        "php-pacakges",
        "packagist-proxy",
        "security-scanner"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php": "^3.300",
        "bitbucket/client": "^5.1",
        "cbschuld/browser.php": "^2.0",
        "composer/composer": "^2.8",
        "composer/semver": "^3.4",
        "doctrine/collections": "^2.2",
        "doctrine/dbal": "^3.10",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.5",
        "doctrine/persistence": "^3.4",
        "knplabs/github-api": "^3.0",
        "knpuniversity/oauth2-client-bundle": "^2.18",
        "league/commonmark": "^2.5",
        "league/flysystem": "^3.29",
        "league/flysystem-aws-s3-v3": "^3.28",
        "league/flysystem-bundle": "^3.3",
        "league/oauth2-client": "^2.8",
        "league/oauth2-github": "^3.1",
        "m4tthumphrey/php-gitlab-api": "^12.0",
        "munusphp/munus": "^0.17",
        "nelmio/api-doc-bundle": "^4.33",
        "nelmio/cors-bundle": "^2.5",
        "nyholm/psr7": "^1.5",
        "omines/oauth2-gitlab": "^3.7",
        "php-http/httplug": "^2.4",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.7",
        "ramsey/uuid-doctrine": "^2.1",
        "sentry/sentry": "^4.10",
        "sentry/sentry-symfony": "^5.0",
        "stevenmaguire/oauth2-bitbucket": "^3.0",
        "symfony/amazon-mailer": "6.4.*",
        "symfony/asset": "6.4.*",
        "symfony/cache-contracts": "^3.5",
        "symfony/config": "6.4.*",
        "symfony/console": "6.4.*",
        "symfony/dependency-injection": "6.4.*",
        "symfony/doctrine-messenger": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/event-dispatcher": "6.4.*",
        "symfony/flex": "^2.4",
        "symfony/form": "6.4.*",
        "symfony/framework-bundle": "6.4.*",
        "symfony/http-client": "6.4.*",
        "symfony/http-client-contracts": "^3.5",
        "symfony/http-foundation": "6.4.*",
        "symfony/http-kernel": "6.4.*",
        "symfony/intl": "6.4.*",
        "symfony/lock": "6.4.*",
        "symfony/mailer": "6.4.*",
        "symfony/messenger": "6.4.*",
        "symfony/mime": "6.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/options-resolver": "6.4.*",
        "symfony/password-hasher": "6.4.*",
        "symfony/routing": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/security-core": "6.4.*",
        "symfony/security-http": "6.4.*",
        "symfony/twig-bridge": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/yaml": "6.4.*",
        "twig/twig": "^3.20",
        "zircote/swagger-php": "^5.0"
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php56": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "require-dev": {
        "coduo/php-matcher": "^6.0",
        "dama/doctrine-test-bundle": "^8.3",
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "ekino/phpstan-banned-code": "^3.0",
        "fakerphp/faker": "^1.24",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/promises": "^2.0",
        "guzzlehttp/psr7": "^2.7",
        "league/flysystem-local": "^3.29",
        "league/flysystem-memory": "^3.28",
        "php-cs-fixer/shim": "^3.9",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "psr/container": "^2.0",
        "rector/rector": "^2.2",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/browser-kit": "6.4.*",
        "symfony/filesystem": "6.4.*",
        "symfony/maker-bundle": "^1.61",
        "symfony/process": "^6.4",
        "symfony/stopwatch": "6.4.*",
        "symfony/web-profiler-bundle": "6.4.*"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    },
    "autoload": {
        "psr-4": {
            "Buddy\\Repman\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Buddy\\Repman\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "bin/console assets:install --symlink"
        ],
        "check-cs": [
            "php-cs-fixer fix --dry-run --diff"
        ],
        "coverage-ci": [
            "phpunit --colors=never --coverage-clover 'clover.xml'",
            "bin/coverage-checker clover.xml 98"
        ],
        "coverage-html": [
            "@phpunit --coverage-html coverage"
        ],
        "fix-cs": [
            "php-cs-fixer fix"
        ],
        "phpstan": [
            "bin/console cache:clear --env=test",
            "phpstan analyse --memory-limit=-1"
        ],
        "phpunit": [
            "@phpunit:unit",
            "@phpunit:integration",
            "@phpunit:functional"
        ],
        "phpunit:unit": [
            "phpunit --colors=always --testsuite=unit"
        ],
        "phpunit:integration": [
            "phpunit --colors=always --testsuite=integration"
        ],
        "phpunit:functional": [
            "phpunit --colors=always --testsuite=functional"
        ],
        "proxy-setup": [
            "symfony proxy:start",
            "symfony proxy:domain:attach repman",
            "symfony proxy:domain:attach repo.repman",
            "export HTTPS_PROXY=http://127.0.0.1:7080"
        ],
        "reset-db": [
            "bin/console doctrine:database:drop --force --if-exists",
            "bin/console doctrine:database:create",
            "bin/console doctrine:migrations:migrate --no-interaction",
            "bin/console messenger:setup-transports"
        ],
        "tests": [
            "@check-cs",
            "@phpstan",
            "bin/console doctrine:schema:validate",
            "@coverage-ci",
            "bin/console lint:twig templates --show-deprecations",
            "rm -rf var/cache/prod",
            "bin/console cache:warmup --env=prod"
        ]
    }
}

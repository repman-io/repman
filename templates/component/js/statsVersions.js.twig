<script>
(function() {
    var chartContainer = document.getElementById('chart-installs-versions');
    if(chartContainer === null) {
        return;
    }

    var chart = new ApexCharts(chartContainer, {
        chart: {
            type: "area",
            fontFamily: 'inherit',
            height: 440,
            parentHeightOffset: 0
        },
        fill: {
            opacity: .16,
            type: 'solid'
        },
        dataLabels: {
            enabled: false,
        },
        stroke: {
            width: 2,
            lineCap: "round",
            curve: "smooth",
        },
        series: [],
        xaxis: {
            type: 'datetime',
        },
        yaxis: {
            labels: {
                formatter: function (value) {
                    return value.toLocaleString();
                },
            },
        },
        colors: ["#206bc4"],
        noData: {
            text: 'Loading...'
        },
        legend: {
            show: true,
            position: 'top',
            showForSingleSeries: true
        }
    });
    chart.render();

    $('.package-version').click(function () {
        var version = $(this).text();
        $.getJSON($(this).data('url'), function(response) {
            chart.updateSeries([{
                name: version,
                data: response
            }]);
        });
        $('.package-version').removeClass('strong text-decoration-underline');
        $(this).addClass('strong text-decoration-underline');
        return false;
    });

    $('.package-version').first().click();
})();
</script>
